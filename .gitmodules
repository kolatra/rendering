[submodule "external/glfw"]
	path = engine/external/glfw
	url = https://github.com/glfw/glfw.git
[submodule "external/assimp"]
	path = engine/external/assimp
	url = https://github.com/assimp/assimp.git
[submodule "external/spdlog"]
	path = engine/external/spdlog
	url = https://github.com/gabime/spdlog.git
[submodule "external/metal-cpp"]
    path = engine/external/metal-cpp
	url = https://github.com/apple/metal-cpp.git
[submodule "external/tomlplusplus"]
	path = engine/external/tomlplusplus
	url = https://github.com/marzer/tomlplusplus.git
[submodule "engine/external/glm"]
	path = engine/external/glm
	url = https://github.com/g-truc/glm.git
